{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Paris",
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "description": "Bloqué : @astrojs/check n'accepte pas TypeScript 7 (ADR-0001)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Patch et mineures regroupées, fusion auto si la CI est verte",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "mises à jour mineures et patch",
      "automerge": true
    },
    {
      "description": "Majeures : revue manuelle",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
