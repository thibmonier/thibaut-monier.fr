{
  "name": "thibaut-monier-fr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "astro": "astro",
    "tokens": "node scripts/gen-tokens.ts",
    "checks:content": "node scripts/checks/run.ts --phase=content",
    "checks:dist": "node scripts/checks/run.ts --phase=dist",
    "build": "npm run checks:content && astro build && npm run checks:dist",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "node scripts/checks/lighthouse.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
