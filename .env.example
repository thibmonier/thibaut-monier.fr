# Variables de build publiques (Astro les inline dans le HTML). Toutes optionnelles : aucune valeur secrète.
# Copier en .env pour un usage local ; sur Railway, les définir comme variables du service.

# URL canonique du site (provisoire tant que le domaine n'est pas branché)
PUBLIC_SITE_URL=

# Identifiant de site Umami Cloud (US-026)
PUBLIC_UMAMI_WEBSITE_ID=

# Clé publique Web3Forms du formulaire de contact (US-008) : publique par conception
PUBLIC_WEB3FORMS_KEY=

# Lien de prise de rendez-vous Calendly (US-008)
PUBLIC_CALENDLY_URL=

# Collecte des métriques open source (make metrics). Jeton GitHub en lecture seule, SECRET : ne jamais
# le mettre dans ce fichier ni dans .env. Le passer au lancement : GITHUB_TOKEN=$(gh auth token) make metrics
# Sans jeton, GitHub limite à 60 requêtes par heure (la collecte en émet environ 42).
# GITHUB_TOKEN=
