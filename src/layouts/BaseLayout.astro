---
import '../styles/global.css';
import Analytics from '../components/seo/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import { site } from '../config/site.ts';
import type { PageMetaProps } from '../lib/page-meta.ts';
import { FEED_TITLE } from '../lib/rss.ts';

/** Props de `Seo` (contrat figé) ; le contrat C5 (`PageMetaProps`) y ajoute `ogType`, `article` et `breadcrumb`. */
interface Props extends PageMetaProps {
  title: string;
  description: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, description, noindex, canonical, ogType, article, breadcrumb } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bloquant et externe (CSP sans script inline) : pose le thème avant le premier rendu. -->
    <script is:inline src="/theme-init.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={FEED_TITLE} href="/rss.xml" />
    <Analytics />
    <Seo
      title={title}
      description={description}
      noindex={noindex}
      canonical={canonical}
      ogType={ogType}
      article={article}
      breadcrumb={breadcrumb}
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body class="relative flex min-h-screen flex-col overflow-x-clip bg-bg text-fg">
    <div
      aria-hidden="true"
      class="glow pointer-events-none fixed inset-0 hidden md:block print:hidden"
    ></div>
    <Header />
    <main
      id="contenu"
      tabindex="-1"
      class="relative mx-auto w-full max-w-7xl grow px-4 py-12 focus:outline-none sm:px-6 lg:px-8"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import '../scripts/reveal.ts';
</script>
