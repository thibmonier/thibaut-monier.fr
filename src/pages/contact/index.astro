---
import CvDownload from '../../components/cv/CvDownload.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import PrivacyNotice from '../../components/contact/PrivacyNotice.astro';
import RdvLink from '../../components/contact/RdvLink.astro';
import { contact } from '../../config/contact.ts';
import { getTranslations } from '../../i18n/utils.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const ui = getTranslations('fr').contact;
---

<BaseLayout
  title="Contact"
  description="Écrire à Thibaut Monier pour une mission, un poste ou une autre demande, ou réserver un échange de 30 minutes."
>
  <div class="max-w-2xl">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{ui.title}</h1>
    <p class="mt-4">{ui.intro}</p>
    {contact.rdvUrl && (
      <p class="mt-6">
        <RdvLink />
      </p>
    )}
    <p class="mt-6">
      <CvDownload />
    </p>
    <ContactForm />
    <PrivacyNotice />
  </div>
</BaseLayout>
