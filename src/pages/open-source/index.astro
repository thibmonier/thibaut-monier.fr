---
import { getCollection } from 'astro:content';
import Icon from '../../components/ui/Icon.astro';
import ProjectCard from '../../components/oss/ProjectCard.astro';
import PluginGrid from '../../components/oss/PluginGrid.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ThemeFilter from '../../components/oss/ThemeFilter.astro';
import { demo } from '../../config/demo.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildItemList } from '../../lib/jsonld/item-list.ts';
import {
  THEME_LABELS,
  THEMES,
  buildSearchEntry,
  countLabel,
  groupByTheme,
  syliusVersions,
  themeCounts,
} from '../../lib/plugins.ts';

const entries = (await getCollection('plugins', ({ data }) => !data.draft)).map((entry) => ({
  slug: entry.id.replace(/^fr\//, ''),
  ...entry.data,
}));
const groups = groupByTheme(entries).map((group) => ({
  ...group,
  plugins: group.plugins.map((plugin) => ({
    slug: plugin.slug,
    name: plugin.name,
    tagline: plugin.tagline,
    syliusVersions: syliusVersions(plugin.compatibility?.matrix ?? []),
    status: plugin.status,
    search: buildSearchEntry({
      id: plugin.slug,
      name: plugin.name,
      tagline: plugin.tagline,
      keywords: [
        group.label,
        plugin.slug,
        ...(plugin.status === 'design' ? ['en conception'] : []),
        ...plugin.features,
      ],
    }),
  })),
}));
const counts = themeCounts(entries);
const catalogue = buildItemList(
  groups.flatMap((group) =>
    group.plugins.map((plugin) => ({
      name: plugin.name,
      path: `/open-source/sylius/${plugin.slug}/`,
    })),
  ),
);
const KIND_LABELS = { bundle: 'Bundle Symfony', contribution: 'Contributions' } as const;
const projects = (await getCollection('projects'))
  .map((entry) => ({ slug: entry.id.replace(/^fr\//, ''), ...entry.data }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<BaseLayout
  title="Plugins Sylius 2 open source : B2B, UE, IA"
  description="24 plugins Sylius 2 open source et une démo en ligne : B2B, conformité UE, back-office, IA et intégrations. Filtrez par thème, ouvrez la fiche."
>
  <JsonLd slot="head" data={[catalogue]} />
  <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Plugins Sylius 2 open source</h1>
  <p class="mt-3 max-w-3xl text-lg text-muted">
    {countLabel(entries.length)} publiés sur GitHub, que j’ai conçus et maintenus pour des boutiques
    Sylius 2 : vente entre professionnels, conformité européenne, outils d’administration, IA et
    intégrations.
  </p>

  <section
    aria-labelledby="demo-titre"
    data-demo-banner
    class="card mt-6 flex flex-col gap-4 p-6 md:flex-row md:items-center md:justify-between"
  >
    <div class="max-w-2xl">
      <h2 id="demo-titre" class="flex items-center gap-2 font-semibold">
        <Icon name="sparkles" />
        Voir les plugins en situation
      </h2>
      <p class="mt-1">
        23 de ces plugins fonctionnent ensemble dans « {demo.name} », une boutique B2B Sylius 2.3 en
        ligne. La démo est remise à zéro chaque nuit à {demo.resetTime} ; les identifiants de test
        sont publics et listés sur la page des comptes de démo.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row md:shrink-0">
      <a
        href={demo.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        data-demo-link="shop"
      >
        Ouvrir la démo<span class="sr-only"> (nouvel onglet)</span>
        <Icon name="arrow-right" />
      </a>
      <a
        href={demo.accountsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
        data-demo-link="accounts"
      >
        Comptes de démo<span class="sr-only"> (nouvel onglet)</span>
      </a>
    </div>
  </section>

  <aside aria-labelledby="intro-titre" class="card mt-6 max-w-3xl p-6">
    <h2 id="intro-titre" class="font-semibold">
      En clair
    </h2>
    <p class="mt-1">
      Sylius est une plateforme libre pour créer une boutique en ligne. Un plugin y ajoute une
      fonction précise, par exemple la facture électronique ou l’approbation des achats, sans
      réécrire la boutique. Chaque fiche explique le besoin couvert, la compatibilité et comment
      l’installer.
    </p>
  </aside>

  <nav data-anchors aria-label="Thèmes du catalogue" class="mt-8">
    <ul class="flex flex-wrap gap-2">
      {THEMES.map((theme) => (
        <li>
          <a href={`#theme-${theme}`} class="chip">
            {THEME_LABELS[theme]} ({counts[theme]})
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-8" data-catalogue>
    <ThemeFilter total={entries.length} />
    <PluginGrid groups={groups} />
  </div>

  <section aria-labelledby="autres-projets" class="mt-14" data-other-projects>
    <h2 id="autres-projets" class="text-2xl font-bold tracking-tight sm:text-3xl">
      Autres projets
    </h2>
    <p class="mt-2 max-w-3xl text-muted">
      Hors du catalogue de plugins : un bundle Symfony que je maintiens et mes contributions à un
      projet open source tiers.
    </p>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          slug={project.slug}
          name={project.name}
          summary={project.summary}
          kindLabel={KIND_LABELS[project.kind]}
        />
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  import '../../scripts/plugin-filter.ts';
</script>
