---
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

// « Retour au blog » seulement quand l'entrée de navigation `blog` est active ; la 404 reste unique pour tout le site.
const blogEnabled = site.nav.main.some((item) => item.id === 'blog' && item.enabled);
---

<BaseLayout
  title="Page introuvable — Thibaut Monier"
  description="Cette page n'existe pas."
  noindex
>
  <h1 class="text-3xl font-bold">Cette page n'existe pas</h1>
  <p class="mt-8">
    <a class="text-accent underline underline-offset-4" href="/">
      Retour à l'accueil
    </a>
  </p>
  {blogEnabled && (
    <p class="mt-2">
      <a class="text-accent underline underline-offset-4" href="/blog/">
        Retour au blog
      </a>
    </p>
  )}
</BaseLayout>
