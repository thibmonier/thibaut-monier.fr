---
import { getEntry } from 'astro:content';
import PersonJsonLd from '../components/seo/PersonJsonLd.astro';
import CtaPair from '../components/ui/CtaPair.astro';
import Hero from '../components/ui/Hero.astro';
import ProfileSummary from '../components/ui/ProfileSummary.astro';
import ProofList from '../components/ui/ProofList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('home', 'accueil');
if (!entry) throw new Error("Entrée 'accueil' introuvable dans la collection home");
const profile = await getEntry('profile', 'fr');
if (!profile) throw new Error("Entrée 'fr' introuvable dans la collection profile");
const { name, headline, valueProp, availability, metaTitle, metaDescription, ctas, proofs } =
  entry.data;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <PersonJsonLd slot="head" variant="home" />
  <div class="flex flex-col gap-12 sm:gap-16">
    <div class="flex flex-col gap-6 sm:gap-8">
      <Hero name={name} headline={headline} valueProp={valueProp} availability={availability} />
      <CtaPair ctas={ctas} />
    </div>
    <ProfileSummary summary={profile.data.summary} />
    <ProofList proofs={proofs} />
  </div>
</BaseLayout>
