---
import BlogIndex from '../../../../components/blog/BlogIndex.astro';
import { categories } from '../../../../lib/blog-taxonomy.ts';
import { paginate } from '../../../../lib/blog.ts';
import { getPublishedPosts } from '../../../../lib/blog-source.ts';

// Pages 2 et suivantes : `/blog/page/1/` n'existe pas (doublon de `/blog/`).
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const pages = paginate(posts, 1)?.pages ?? 1;
  return Array.from({ length: pages - 1 }, (_, index) => {
    const number = index + 2;
    const current = paginate(posts, number);
    if (current === null) throw new Error(`Liste du blog : page ${number} introuvable`);
    return {
      params: { page: String(number) },
      props: {
        posts: current.items,
        page: number,
        pages,
        total: posts.length,
        categories: categories(posts),
      },
    };
  });
}

const props = Astro.props;
---

<BlogIndex {...props} />
