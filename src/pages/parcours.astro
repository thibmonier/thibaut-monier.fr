---
import { getCollection } from 'astro:content';
import EarlierCareer from '../components/cv/EarlierCareer.astro';
import ExperienceCard from '../components/cv/ExperienceCard.astro';
import Timeline from '../components/cv/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { splitFeatured } from '../lib/experiences.ts';

const entries = await getCollection('experiences');
const { featured, earlier } = splitFeatured(
  entries.map((entry) => ({ ...entry.data, id: entry.id })),
);
---

<BaseLayout
  title="Parcours professionnel"
  description="Parcours de Thibaut Monier, de développeur à directeur technique : rôles, périodes, contextes et réalisations, de SQLI à aujourd'hui."
>
  <h1 class="text-3xl font-bold tracking-tight">Parcours professionnel</h1>
  <p class="mt-3 max-w-3xl text-lg text-muted">
    Du développement logiciel à la direction technique : les dix dernières années en détail, les
    précédentes en résumé.
  </p>

  <div class="mt-10">
    <Timeline>
      {featured.map((item) => (
        <ExperienceCard
          slug={item.id}
          company={item.company}
          role={item.role}
          start={item.start}
          end={item.end}
          context={item.context}
          achievements={item.achievements}
        />
      ))}
    </Timeline>
  </div>

  <EarlierCareer
    items={earlier.map((item) => ({
      slug: item.id,
      company: item.company,
      role: item.role,
      start: item.start,
      end: item.end,
      summaryOnly: item.summaryOnly ?? '',
    }))}
  />
</BaseLayout>

<script>
  import '../scripts/experience-toggle.ts';
</script>

<style is:global>
  @media print {
    @page {
      margin: 12mm;
    }
    html {
      font-size: 9pt !important;
    }
    header,
    footer,
    .sr-only {
      display: none !important;
    }
    main {
      padding: 0 !important;
    }
    h1 {
      font-size: 1.5rem !important;
    }
  }
</style>
