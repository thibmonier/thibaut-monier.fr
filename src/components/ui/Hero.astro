---
interface Props {
  name: string;
  headline: string;
  valueProp: string;
  availability: string;
}

const { name, headline, valueProp, availability } = Astro.props;
---

<section class="max-w-3xl">
  <p class="text-base font-medium text-muted">{name}</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{headline}</h1>
  <p data-value-prop class="mt-4 text-lg text-fg">
    {valueProp}
  </p>
  <p class="mt-2 text-base text-muted">{availability}</p>
</section>
