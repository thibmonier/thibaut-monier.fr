---
import CvDownload from '../cv/CvDownload.astro';
import { getTranslations } from '../../i18n/utils.ts';
import Icon from './Icon.astro';

// Profil mis en avant sur l'accueil (décision PO du 2026-10-20) : le résumé vient du CV (collection
// `profile`), source unique avec le PDF.
interface Props {
  summary: string;
}

const { summary } = Astro.props;
const ui = getTranslations('fr').home;
---

<section aria-labelledby="profil-titre" class="card mx-auto max-w-4xl p-6 sm:p-8">
  <h2 id="profil-titre" class="text-2xl font-bold tracking-tight sm:text-3xl">
    {ui.profileHeading}
  </h2>
  <p data-profile-summary class="mt-4 text-lg text-muted">
    {summary}
  </p>
  <p class="mt-6 flex flex-col gap-4 sm:flex-row">
    <a href="/parcours/" class="btn btn-primary">
      <Icon name="arrow-right" />
      {ui.profileLink}
    </a>
    <CvDownload />
  </p>
</section>
