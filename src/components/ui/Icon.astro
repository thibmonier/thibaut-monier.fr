export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

// Toujours décorative : le texte voisin porte le sens.
const { name, class: className = 'size-5' } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={ICONS[name]}
/>
