---
import { site } from '../../config/site.ts';
import { getTranslations, type Locale } from '../../i18n/utils.ts';
import { enabledItems } from '../../lib/navigation.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const ui = getTranslations(locale);
const legal = enabledItems(site.nav.footer);
const social = [
  { label: 'LinkedIn', href: site.social.linkedin, event: 'outbound_linkedin' },
  { label: 'GitHub', href: site.social.github, event: 'outbound_github' },
];
const link =
  'inline-flex min-h-11 items-center rounded-md px-1 text-muted underline-offset-4 transition-colors hover:text-accent hover:underline';
---

<footer class="relative mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-4 py-12 text-sm sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="text-lg font-bold text-fg">{site.name}</p>
      <nav aria-label={ui.footer.label}>
        <ul class="flex flex-wrap gap-x-4">
          {legal.map((item) => (
            <li>
              <a class={link} href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a class={link} href="/rss.xml">
              {ui.footer.rss}
            </a>
          </li>
          {social.map((item) => (
            <li>
              <a class={link} href={item.href} rel="noopener noreferrer" data-event={item.event}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="mt-8 border-t border-border pt-8 text-center text-xs text-muted">
      © {new Date().getFullYear()} {site.name}. {ui.footer.rights}.
    </p>
  </div>
</footer>
