---
import { site } from '../../config/site.ts';
import { getTranslations, type Locale } from '../../i18n/utils.ts';
import { enabledItems, isActive } from '../../lib/navigation.ts';
import SkipLink from './SkipLink.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const ui = getTranslations(locale);
const items = enabledItems(site.nav.main);
const path = Astro.url.pathname;
// Lien courant : couleur accent et soulignement (repère non porté par la seule couleur).
const current =
  'aria-[current=page]:text-accent aria-[current=page]:underline aria-[current=page]:underline-offset-8';
const navLink = `inline-flex min-h-11 w-full items-center rounded-md px-3 text-sm font-medium text-fg transition-colors hover:text-accent md:w-auto ${current}`;
// Contact en pastille, comme un appel à l'action d'en-tête.
const contactLink = `inline-flex min-h-11 w-full items-center rounded-full bg-fg/10 px-4 text-sm font-semibold text-fg transition-all hover:bg-fg/20 md:ml-2 md:w-auto ${current}`;
---

<SkipLink locale={locale} />
<header
  class="sticky top-0 z-50 border-b border-border bg-bg md:bg-bg/50 md:backdrop-blur"
  data-menu-scope
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-2 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="/"
      class="order-1 inline-flex min-h-11 items-center rounded-md pr-2 text-xl font-bold tracking-tight text-fg transition-colors hover:text-accent"
    >
      {site.name}
    </a>
    <div class="order-2 ml-auto flex items-center gap-1 md:order-3 md:ml-0">
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-nav"
        class="hidden min-h-11 items-center gap-2 rounded-md px-3 font-medium text-fg hover:bg-fg/10 js:max-md:inline-flex"
      >
        <Icon name="menu" />
        {ui.nav.menu}
      </button>
      <ThemeToggle locale={locale} />
    </div>
    <nav
      id="site-nav"
      data-site-nav
      aria-label={ui.nav.main}
      class="site-nav order-3 w-full md:order-2 md:ml-auto md:w-auto"
    >
      <ul class="flex flex-col pb-2 md:flex-row md:items-center md:gap-2 md:pb-0">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(path, item.href) ? 'page' : undefined}
              class={item.id === 'contact' ? contactLink : navLink}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Amélioration progressive : le menu n'est replié que si JavaScript est actif. */
  @media (max-width: 47.99rem) {
    :global(.js) .site-nav:not([data-open='true']) {
      display: none;
    }
  }
</style>

<script>
  import '../../scripts/mobile-menu.ts';
</script>
