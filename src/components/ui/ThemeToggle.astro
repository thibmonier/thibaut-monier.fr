---
import { t, type Locale } from '../../i18n/utils.ts';
import Icon from './Icon.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
---

<!-- Masqué sans JavaScript : le thème suit alors la préférence système (CSS). -->
<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t(locale, 'theme.toggle')}
  class="hidden size-11 items-center justify-center rounded-full text-fg transition-colors hover:bg-fg/10 js:inline-flex"
>
  <!-- Lune en thème clair, soleil en thème sombre (comme Agentic Agency). -->
  <Icon name="moon" class="size-5 dark:hidden" />
  <Icon name="sun" class="hidden size-5 dark:block" />
</button>

<script>
  import '../../scripts/theme-toggle.ts';
</script>
