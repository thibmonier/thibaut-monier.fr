---
interface Props {
  matrix: { sylius: string; php: string; symfony: string[] }[];
  databases: string[];
}

const { matrix, databases } = Astro.props;
const labels: Record<string, string> = {
  mysql: 'MySQL',
  mariadb: 'MariaDB',
  postgresql: 'PostgreSQL',
};
---

<section aria-labelledby="compat-titre" data-compat>
  <h2 id="compat-titre" class="text-xl font-semibold tracking-tight">
    Compatibilité
  </h2>
  <div
    role="region"
    aria-labelledby="compat-titre"
    tabindex="0"
    class="mt-3 overflow-x-auto rounded-md border border-border"
  >
    <table class="w-full min-w-[26rem] border-collapse text-left text-sm sm:min-w-0">
      <caption class="sr-only">Versions de Sylius, PHP et Symfony prises en charge</caption>
      <thead>
        <tr class="border-b border-border bg-surface">
          <th scope="col" class="px-3 py-2 font-semibold">
            Sylius
          </th>
          <th scope="col" class="px-3 py-2 font-semibold">
            PHP
          </th>
          <th scope="col" class="px-3 py-2 font-semibold">
            Symfony
          </th>
        </tr>
      </thead>
      <tbody>
        {matrix.map((row) => (
          <tr class="border-b border-border last:border-0">
            <th scope="row" class="px-3 py-2 align-top font-medium">
              {row.sylius}
            </th>
            <td class="px-3 py-2 align-top">{row.php}</td>
            <td class="px-3 py-2 align-top">{row.symfony.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-sm" data-databases>
    <span class="font-medium">Bases de données :</span>
    {databases.map((db) => labels[db] ?? db).join(', ')}
  </p>
</section>
