---
interface Props {
  command: string;
  note?: string;
}

const { command, note } = Astro.props;
---

<div
  data-copy-root
  data-copied="Commande copiée"
  data-failed="Copie impossible : sélectionnez la commande."
>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
    <pre
      class="grow overflow-x-auto rounded-md border border-border bg-surface p-3 text-sm"
      tabindex="0"
    ><code class="font-mono">{command}</code></pre>
    <button
      type="button"
      hidden
      class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-4 font-medium hover:border-accent"
    >
      Copier la commande
    </button>
  </div>
  <p role="status" aria-live="polite" class="mt-1 min-h-6 text-sm font-medium"></p>
  {note && (
    <p class="text-sm text-muted" data-install-note>
      {note}
    </p>
  )}
</div>

<script>
  import '../../scripts/copy-command.ts';
</script>
