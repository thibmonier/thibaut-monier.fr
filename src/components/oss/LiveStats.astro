---
import type { LiveStats } from '../../lib/live-stats.ts';

interface Props {
  stats: LiveStats | null;
  heading?: string;
}

const { stats, heading = 'Activité du projet' } = Astro.props;
---

{stats && (
  <section aria-labelledby="stats-titre" data-live-stats>
    <h2 id="stats-titre" class="text-xl font-semibold tracking-tight">
      {heading}
    </h2>
    <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2">
      {stats.items.map((item) => (
        <div data-stat={item.id}>
          <dt class="text-sm text-muted">{item.label}</dt>
          <dd class="font-semibold">{item.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-2 text-sm text-muted" data-stats-date>
      Données au {stats.asOf}
    </p>
  </section>
)}
