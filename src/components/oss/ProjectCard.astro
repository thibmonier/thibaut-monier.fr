---
interface Props {
  slug: string;
  name: string;
  summary: string;
  kindLabel: string;
}

const { slug, name, summary, kindLabel } = Astro.props;
---

<li
  data-project={slug}
  class="relative flex flex-col rounded-lg border border-border bg-surface p-4 focus-within:border-accent hover:border-accent"
>
  <h3 class="text-lg font-semibold tracking-tight">
    <a
      href={`/open-source/${slug}/`}
      class="after:absolute after:inset-0 after:content-[''] hover:text-accent"
    >
      {name}
    </a>
  </h3>
  <p class="mt-1 grow text-base">{summary}</p>
  <p class="mt-3 text-sm text-muted">{kindLabel}</p>
</li>
