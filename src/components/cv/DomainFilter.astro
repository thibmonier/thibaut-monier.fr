---
import { ALL_LABEL, DOMAIN_IDS, DOMAIN_LABELS } from '../../lib/filters.ts';

// Groupe de boutons à bascule (US-006). Rendu masqué sans JavaScript (variante `js`, classe posée par
// theme-init.js) : aucun contrôle inerte ; avec JavaScript, skill-filter.ts pilote `aria-pressed`.
const button = 'chip shrink-0';
---

<div
  data-domain-filter
  role="group"
  aria-label="Filtrer par domaine"
  class="hidden gap-2 overflow-x-auto p-1 js:flex md:flex-wrap md:overflow-visible"
>
  <button type="button" data-domain="" aria-pressed="true" class={button}>
    {ALL_LABEL}
  </button>
  {DOMAIN_IDS.map((id) => (
    <button type="button" data-domain={id} aria-pressed="false" class={button}>
      {DOMAIN_LABELS[id]}
    </button>
  ))}
</div>
