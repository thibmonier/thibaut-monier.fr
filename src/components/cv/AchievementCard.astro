---
import { DOMAIN_LABELS, clientsLabel, type DomainId } from '../../lib/filters.ts';

interface Props {
  id: string;
  title: string;
  year: number;
  domains: DomainId[];
  clients: string[];
  skills: string[]; // libellés déjà résolus
  proofUrl?: string | undefined;
}

const { id, title, year, domains, clients, skills, proofUrl } = Astro.props;
---

<li data-achievement={id} data-domains={domains.join(' ')} class="reveal card p-6">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg leading-snug font-semibold">{title}</h3>
    <p data-year class="shrink-0 text-sm font-medium text-muted">
      {year}
    </p>
  </div>
  <ul aria-label="Domaines" class="mt-3 flex flex-wrap gap-2">
    {domains.map((domain) => (
      <li
        data-domain-tag
        class="rounded-full border border-accent/20 bg-accent/10 px-3 py-0.5 text-xs font-semibold text-accent"
      >
        {DOMAIN_LABELS[domain]}
      </li>
    ))}
  </ul>
  <p data-clients class="mt-3 text-sm">
    <span class="font-medium">Référence :</span>
    {clientsLabel(clients)}
  </p>
  {skills.length > 0 && <p class="mt-1 text-sm text-muted">Compétences : {skills.join(', ')}</p>}
  {proofUrl && (
    <p class="mt-3">
      <a
        href={proofUrl}
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-md font-medium text-accent underline underline-offset-4"
      >
        Voir la preuve<span class="sr-only"> : {title}</span>
      </a>
    </p>
  )}
</li>
