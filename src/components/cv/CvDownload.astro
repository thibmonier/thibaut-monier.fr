---
import { getTranslations } from '../../i18n/utils.ts';
import Icon from '../ui/Icon.astro';

// US-007 : lien de téléchargement du CV PDF. Libellé statique (le nombre de pages est vérifié au build par
// scripts/checks/cv-pdf.dist.check.ts) ; `data-cv-download` sert à la mesure d'audience (US-026).
const ui = getTranslations('fr').cv;
---

<a
  data-cv-download
  data-event="cv_download"
  href="/thibaut-monier-cv.pdf"
  download="thibaut-monier-cv.pdf"
  class="btn btn-secondary print:hidden"
>
  <Icon name="download" />
  {ui.download}
</a>
