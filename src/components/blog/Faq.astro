---
interface Props {
  items: { question: string; answer: string }[];
}

// Questions repliables (details/summary) : accessibles au clavier, sans JavaScript.
const { items } = Astro.props;
---

<section data-faq aria-labelledby="faq-titre" class="mt-12">
  <h2 id="faq-titre" class="text-2xl font-semibold tracking-tight">
    Questions fréquentes
  </h2>
  <div class="mt-4 divide-y divide-border rounded-lg border border-border">
    {items.map((item) => (
      <details class="group px-4">
        <summary class="flex min-h-11 cursor-pointer items-center py-2 font-semibold">
          <h3 class="inline text-base font-semibold">{item.question}</h3>
        </summary>
        <p class="pb-4">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
