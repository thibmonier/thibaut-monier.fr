---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { postPath, slugOf, type BlogEntry } from '../../lib/blog.ts';
import PostDate from './PostDate.astro';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { data } = post;
// Image décorative (alt vide) : le titre, juste en dessous, porte le sens.
const cover = data.image as ImageMetadata | undefined;
---

<li data-article-card class="reveal card card-link group relative flex flex-col overflow-hidden">
  {cover && (
    <Image
      src={cover}
      alt=""
      widths={[320, 640]}
      sizes="(min-width: 768px) 24rem, 100vw"
      loading="lazy"
      class="aspect-[1200/630] w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  )}
  <div class="relative flex grow flex-col bg-card p-6">
    <p class="text-sm text-muted">
      <PostDate date={data.pubDate} />
      <span aria-hidden="true"> · </span>
      <span data-card-category>{data.category}</span>
    </p>
    <h2 class="mt-2 text-xl font-semibold tracking-tight">
      <a
        href={postPath(slugOf(post.id))}
        class="after:absolute after:inset-0 after:content-[''] hover:text-accent"
      >
        {data.title}
      </a>
    </h2>
    <p data-card-excerpt class="mt-3 grow text-muted">
      {data.excerpt ?? data.description}
    </p>
  </div>
</li>
