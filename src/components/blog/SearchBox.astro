---
// Interface de recherche maison sur l'API JavaScript de Pagefind (ADR-0013) : rendue masquée sans JavaScript
// (variante `js`), le repli est le bloc `data-search-fallback` de la page. Le script `search.ts` charge l'index à la première
// interaction ; les résultats sont des nœuds DOM construits côté navigateur.
---

<div data-search data-index="idle" data-state="idle" class="mt-6 hidden js:block">
  <form role="search" class="flex flex-col gap-2">
    <label for="recherche-champ" class="font-semibold">
      Rechercher dans le blog
    </label>
    <input
      id="recherche-champ"
      type="search"
      name="q"
      autocomplete="off"
      spellcheck="false"
      class="min-h-12 w-full rounded-xl border-2 border-line bg-card px-4 text-base text-fg"
    />
  </form>
  <p data-search-status aria-live="polite" class="mt-3 text-sm font-medium text-muted"></p>
  <p data-search-message aria-live="polite" class="mt-3"></p>
  <ul data-search-results class="mt-4 flex flex-col gap-4"></ul>
</div>

<script>
  import '../../scripts/search.ts';
</script>
