---
import PostDate from './PostDate.astro';

interface Props {
  url: string;
  date: Date;
}

// Texte, jamais une icône seule : le lien vers l'ancien site reste tant qu'il existe (voir docs/guides/redirections-blog.md).
const { url, date } = Astro.props;
---

<p data-original-notice data-pagefind-ignore class="mt-8 text-sm text-muted">
  Initialement publié sur{' '}
  <a href={url} rel="noopener noreferrer" class="underline underline-offset-4">
    Agentic Agency
  </a>{' '}
  le <PostDate date={date} />.
</p>
